// Zipline v1.1.3
// Novys (mncd)

/*
Setup:
    var zip/x = destination x
    var zip/y = destination y
    var zip/z = destination z
    var zip/active = 1

Optional Setup:
    var zip/slack = slack factor (default: 5) [range: -inf to inf]
        -x  : works intuitively (goes upwards)
        1   : no slack
        5   : normal slack
        10  : heavy slack
    var zip/mag = magnitude factor (10) [-inf to inf]
        <-5 : may cause issues
        -x  : works intuitively (inverse slope acceleration)
        1   : base acceleration
        10  : x10 slope acceleration
        100 : x100 slope acceleration
    var zip/decay = decay factor (10) [-inf to inf]
        -x  : works intuitively (reverses decay)
        1   : no decay
        10  : normal decay
        50  : extremely light decay
        >50 : may cause issues
    var zip/speed = set initial speed (1000) [0+]
        -x  : does not support negative values
*/

// recur 5t
// goto function "Zipline"

if (var zip/active == 0 0, var zip/dist = 0 0) {
    exit
} else {
// velocities & distance
    var zip/px = "%var.player/zip/x 0%L"
    var zip/px -= %player.location.x%
    var zip/vx = var zip/px 0
    var zip/py = "%var.player/zip/y 0%L"
    var zip/py -= %player.location.y%

    var zip/vy = var zip/py 0
    var zip/slope = var zip/py 0
    var zip/pz = "%var.player/zip/z 0%L"
    var zip/pz -= %player.location.z%
    var zip/vz = var zip/pz 0

    var zip/pz *= var zip/pz 0
    var zip/px *= var zip/px 0
    var zip/py *= var zip/py 0
    var zip/px += var zip/pz 0
    var zip/px += var zip/py 0

// SQRT
    var d = 3037000498
    var d /= var zip/px 0
    var d += 1
    var zip/px *= var d 0
    var zip/px *= var d 0

    var c = var zip/px 0
    var c /= 537752656
    var c += 880298
    var a = var zip/px 0
    var a /= var c 0
}
if () {
    var a += var c 0
    var c = var zip/px 0
    var c /= var a 0
    var a /= 4
    var a += var c 0

    var b = var zip/px 0
    var b /= var a 0
    var b += var a 0
    var c = var zip/px 0
    var c /= var b 0

    var b /= 4
    var b += var c 0
    var zip/dist = var zip/px 0
    var zip/dist /= var b 0
    var zip/dist += var b 0

    var zip/px /= var zip/dist 0
    var zip/dist /= 4
    var zip/dist += var zip/px 0
    var zip/dist += 1
    var zip/dist /= var d
// SQRT END

// failsafes
    var zip/delta = var zip/dist 0
    var zip/delta -= var zip/dist/s 0
    var zip/dist/s /= var zip/dist/s 0
    var zip/delta *= var zip/dist/s 0
}
if () {
    var a = var c 0
    var a /= var a 0
    var a *= -1
    var a += 1
    var zip/stuck *= var a 0
    var zip/stuck += var a 0

    var zip/slope *= var zip/mag 10
    var zip/slope *= -1
}

// vector projection
if (var zip/active == 1 0) {
    var zip/x0 = %player.location.x%
    var zip/y0 = %player.location.y%
    var zip/z0 = %player.location.z%

    // direction vector
    var zip/dx = "%var.player/zip/x 0%L"
    var zip/dx -= var zip/x0 0
    var zip/dy = "%var.player/zip/y 0%L"
    var zip/dy -= var zip/y0 0
    var zip/dz = "%var.player/zip/z 0%L"
    var zip/dz -= var zip/z0 0
    var zip/spd = var zip/speed 1000
}
if () {
    // player vector
    var zip/px = %player.location.x%
    var zip/px -= var zip/x0 0
    var zip/py = %player.location.y%
    var zip/py -= var zip/y0 0
    var zip/pz = %player.location.z%

    var zip/pz -= var zip/z0 0
    var a = var zip/px 0
    var a *= var zip/dx 0
    var b = var zip/py 0
    var b *= var zip/dy 0

    var a += var b 0
    var b = var zip/pz 0
    var b *= var zip/dz 0
    var a += var b 0
    var c = var zip/dx 0

    var c *= var zip/dx 0
    var d = var zip/dy 0
    var d *= var zip/dy 0
    var c += var d 0
    var d = var zip/dz 0

    var d *= var zip/dz 0
    var c += var d 0
    var zip/speed = var a 0
    var zip/speed *= 1000
    var zip/speed /= var c 0
}

if (var zip/active == 1) {
// acceleration
    var zip/dist/o = var zip/dist 0
    var zip/slope /= var zip/dist/o 0

// fallback
    var zip/active = 200
    var a = var zip/dist 0
    var a -= 17
    var a /= 3
    var a *= 5
    var b *= 5

    var c = var zip/slope 0
    var c *= 10
    var c /= var zip/mag 10
    var c *= -20
    
    var zip/active += var a 0
    var zip/active += var b 0
    var zip/active += var c 0

    var zip/mag Unset
} else {
    var zip/slope /= var zip/dist/o 0
    var zip/dist/s = var zip/dist 0

// failsafes
    var zip/dist/f = var zip/spd 0
    var zip/dist/f /= 5000
    var zip/dist/f += 1

    var zip/bo = var zip/spd 0
    var zip/bo /= -1000
    var zip/bo -= 1
}

// failsafes
if or (var zip/active <= 0 0, var zip/delta < var zip/bo -3, var zip/stuck >= 8 0) {
    // sound "Horse Saddle" 0.7 1 "invokers_location"
    var zip/dist = 0
}

// final
if (var zip/dist <= var zip/dist/f 1) {
    tp "custom_coordinates" "%var.player/zip/x% ~ ~"
    tp "custom_coordinates" "~ %var.player/zip/y% ~"
    tp "custom_coordinates" "~ ~ %var.player/zip/z%"
    changeVelocity 0 0 0

    // footprint cleanup
    var zip/dist Unset
    var zip/active Unset
    var zip/stuck Unset
    var zip/speed Unset
    var zip/dist/f Unset

    var zip/slope Unset
    var zip/decay Unset
    var zip/bo Unset
    var zip/px Unset
    var zip/py Unset

    var zip/pz Unset
    var zip/delta Unset
    var a Unset
    var b Unset
    var c Unset

    var d Unset
    var zip/vx Unset
    var zip/vy Unset
    var zip/vz Unset
    var zip/x Unset

    var zip/y Unset
    var zip/z Unset
    var zip/spd Unset
    var zip/slack Unset
    var zip/dist/s Unset
} else {
    var zip/active -= 5
}

if (!var zip/active == 0 0) {
// velocity calculation
    var zip/spd /= var zip/dist 0
    var zip/vx *= var zip/spd 0
    var zip/vy *= var zip/spd 0
    var zip/vz *= var zip/spd 0
    var zip/spd *= var zip/dist 0

    var a = var zip/vx 0
    var a += 4611686018427387904
    var a /= 4611686018427387904
    var a *= 2
    var a -= 1
    var a *= 500
    var zip/vx += var a 0
    var zip/vx /= 1000

    var a = var zip/vy 0
    var a += 4611686018427387904
    var a /= 4611686018427387904
    var a *= 2
} else {
    // footprint cleanup
    var zip/dist/o Unset
    var zip/x0 Unset
    var zip/y0 Unset
    var zip/z0 Unset
    var zip/dx Unset

    var zip/dy Unset
    var zip/dz Unset

    exit
}
if () {
    var a -= 1
    var a *= 500
    var zip/vy += var a 0
    var zip/vy /= 1000

    var a = var zip/vz 0
    var a += 4611686018427387904
    var a /= 4611686018427387904
    var a *= 2
    var a -= 1
    var a *= 500
    var zip/vz += var a 0
    var zip/vz /= 1000

// slack
    var zip/speed += 100
    var a = 1000
    var a -= var zip/speed 0
    var a *= var zip/speed 0
    var a /= 10000

    var a *= var zip/slack 5
    var a /= 100

    var zip/vy -= var a 0

    // velocity change
    changeVelocity "%var.player/zip/vx 0%" "%var.player/zip/vy 0%" "%var.player/zip/vz 0%"
    pause 1
    changeVelocity "%var.player/zip/vx 0%" "%var.player/zip/vy 0%" "%var.player/zip/vz 0%"
    pause 1
    changeVelocity "%var.player/zip/vx 0%" "%var.player/zip/vy 0%" "%var.player/zip/vz 0%"
    pause 1
    changeVelocity "%var.player/zip/vx 0%" "%var.player/zip/vy 0%" "%var.player/zip/vz 0%"
    pause 1
    changeVelocity "%var.player/zip/vx 0%" "%var.player/zip/vy 0%" "%var.player/zip/vz 0%"
}

// acceleration
if (var zip/slope >= 0 0) {
    var zip/spd += 500

    var zip/slope *= 100
    var zip/spd += var zip/slope 0
} else {
    var a = 8000
    var a -= var zip/spd 0
    var a /= var zip/decay 10
    var zip/spd += var a 0
}

if () {
    var zip/spd -= 28000
    var b = var zip/spd 0
    var b /= var b 0
    var b -= 1
    var b *= var zip/spd 0
    var zip/spd -= var b 0
    var zip/spd += 28000
}
